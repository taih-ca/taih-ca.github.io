source "https://rubygems.org"

# Use the github-pages gem so local builds match GitHub Pages exactly.
gem "github-pages", group: :jekyll_plugins

# Required for local serving on Ruby 3+ (webrick was removed from stdlib).
gem "webrick", "~> 1.8"

# Ruby 3.4+/4.x removed these from the default gems; Jekyll 3.9 still needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
